<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Material3Expressive.DynamicColors.Dark">
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity
            android:name=".ManageFilesActivity"
            android:label="@string/app_name"
            android:theme="@style/BootloaderSettingsTheme"
            android:exported="false" />
        <activity
            android:name=".BootloaderSettingsActivity"
            android:label="替换 bootloader 设置"
            android:theme="@style/BootloaderSettingsTheme"
            android:exported="false" />
        <activity
            android:name=".OperationActivity"
            android:label="运行状态"
            android:theme="@style/BootloaderSettingsTheme"
            android:exported="false" />
        <activity
            android:name=".BackupActivity"
            android:label="备份"
            android:theme="@style/BootloaderSettingsTheme"
            android:exported="false" />
    </application>

</manifest>
